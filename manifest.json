{
  "manifest_version": 3,
  "name": "Custom Autofill",
  "version": "2.3",
  "description": "Fill inputs, radios, checkboxes and dropdowns from your own reusable rules.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Custom Autofill" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill the current page"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["fill.js"],
    "all_frames": true,
    "run_at": "document_idle"
  }]
}
